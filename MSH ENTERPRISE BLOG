    function buildPostObjectFromForm() {
      const cat = document.getElementById("post-category").value;
      const author = document.getElementById("post-author").value.trim() || "MSH ENTERPRISE";
      const title = document.getElementById("post-title").value.trim();
      const excerpt = document.getElementById("post-excerpt").value.trim();
      const bodyRaw = document.getElementById("post-body").value.trim();

      const catObj = categories.find(c => c.key === cat) || categories[1];
      const paragraphs = bodyRaw.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean);
      const now = new Date();
      const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

      return {
        id: "post-" + Date.now(),
        featured: false,
        category: cat,
        catLabelEn: catObj.labelEn,
        catLabelSw: catObj.labelSw,
        date: `${monthNames[now.getMonth()]} ${now.getFullYear()}`,
        readTime: `${Math.max(2, Math.ceil(bodyRaw.split(/\s+/).length / 180))} min read`,
        author,
        titleEn: title,
        titleSw: title,
        excerptEn: excerpt,
        excerptSw: excerpt,
        paragraphsEn: paragraphs.length ? paragraphs : [excerpt],
        paragraphsSw: paragraphs.length ? paragraphs : [excerpt]
      };
    }

    function publishNewPost() {
      const title = document.getElementById("post-title").value.trim();
      const excerpt = document.getElementById("post-excerpt").value.trim();
      const body = document.getElementById("post-body").value.trim();

      if (!title || !excerpt || !body) {
        showToast("Please fill in Title, Summary, and Content first.");
        return;
      }

      const newPost = buildPostObjectFromForm();
      let existing = [];
      try {
        const raw = localStorage.getItem(CUSTOM_POSTS_KEY);
        if (raw) existing = JSON.parse(raw);
      } catch (e) {}

      existing.unshift(newPost);
      try {
        localStorage.setItem(CUSTOM_POSTS_KEY, JSON.stringify(existing));
      } catch (e) {}

      document.getElementById("post-title").value = "";
      document.getElementById("post-excerpt").value = "";
      document.getElementById("post-body").value = "";

      closeComposerModal();
      renderFeaturedPost();
      renderBlogGrid();
      showToast("Article published to MSH ENTERPRISE Blog!");
    }

    function copyPostCodeSnippet() {
      const title = document.getElementById("post-title").value.trim();
      const excerpt = document.getElementById("post-excerpt").value.trim();
      const body = document.getElementById("post-body").value.trim();
      if (!title || !excerpt || !body) {
        showToast("Fill in your article fields first to generate the GitHub snippet.");
        return;
      }
      const snippet = JSON.stringify(buildPostObjectFromForm(), null, 2) + ",";
      const ta = document.createElement("textarea");
      ta.value = snippet;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand("copy");
        showToast("Post JSON snippet copied! Paste inside defaultPosts in blog.html.");
      } catch (e) {}
      document.body.removeChild(ta);
    }

    // Close modals on backdrop click
    document.getElementById("reader-modal").addEventListener("click", function(e) {
      if (e.target === this) closeReaderModal();
    });
    document.getElementById("composer-modal").addEventListener("click", function(e) {
      if (e.target === this) closeComposerModal();
    });

    // Init
    window.addEventListener("DOMContentLoaded", () => {
      syncBlogYears();
      renderCategoryPills();
      renderFeaturedPost();
      renderBlogGrid();
      lucide.createIcons();
    });
  </script>
</body>
</html>
